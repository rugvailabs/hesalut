{
  "expo": {
    "name": "hesalut",
    "slug": "hesalut",
    "scheme": "hesalut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.hesalut.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used only to sort listings by how close they are to you. Your location is never stored or shared.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ca.hesalut.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Used only to sort listings by how close they are to you. Your location is never stored or shared."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used only while voice search is listening, to hear what you are looking for. Nothing is recorded or stored.",
          "speechRecognitionPermission": "Used to turn your voice search into text, on your device where possible. Nothing is stored or shared.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
