# Base URL of the FastAPI backend.
#
# Read SERVER-SIDE only (Server Components, lib/api.ts, route handlers). The
# backend ships no CORS middleware, so the browser cannot call this origin
# directly; and the JWT lives in an httpOnly cookie that client JS cannot read.
# The NEXT_PUBLIC_ prefix is kept for continuity with the rest of the project.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps (browser key). When set, every map in the app - search results,
# business profiles, the admin listing view and the listing form's pin picker -
# uses Google Maps; when blank they fall back to OpenStreetMap.
#
# In Google Cloud Console enable "Maps JavaScript API" (and "Geocoding API" for
# the listing form's "Find address on map"), create an API key, and restrict it
# to HTTP referrer http://localhost:3001/*. Restart `npm run dev` after changing
# it: NEXT_PUBLIC_ values are read when the dev server starts.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Advanced markers need a Map ID; Google's DEMO_MAP_ID is used when
# this is blank, which is fine for development.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Let search engines index the site. Leave unset (or anything but "true") for
# every test deployment - the seeded demo listings are not real businesses.
ALLOW_INDEXING=

# Largest verification document accepted, in MB. Defaults to 10. Set 4 on
# Vercel, whose functions reject request bodies over ~4.5 MB.
NEXT_PUBLIC_MAX_DOCUMENT_MB=

# Shared with the API's TRUSTED_PROXY_SECRET so rate limits apply per visitor,
# not per web server. Leave blank locally.
INTERNAL_PROXY_SECRET=
